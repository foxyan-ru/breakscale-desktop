    "annotations": [
      { "id": "wa-sec-conn", "kind": "section", "label": "Keeping phones connected", "x": 12, "y": 44, "width": 760, "height": 120, "tone": 0 },
      { "id": "wa-sec-route", "kind": "section", "label": "Sending a message, or parking it", "x": 272, "y": 238, "width": 1020, "height": 250, "tone": 1 },
      { "id": "wa-sec-media", "kind": "section", "label": "Photos and video, on their own path", "x": 12, "y": 562, "width": 760, "height": 250, "tone": 2 },
      {
        "id": "wa-note-conn", "kind": "note",
        "text": "What runs out here is open connections, not requests. 45 phones connect a second and each holds on for 30 seconds, filling 1350 of the 1800 slots. This box is run deliberately hot, because connections were the entire cost of the system.",
        "x": 800, "y": 16, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "wa-note-route", "kind": "note",
        "text": "The router does almost nothing per message: it cannot even read them. At 400 a second it is about one percent busy. Simple and small beat big here, and that was the point.",
        "x": 1320, "y": 232, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "wa-note-store", "kind": "note",
        "text": "Turn the load up to 4x and watch the offline store, not the error rate. A message to a phone that is not online parks here until it reconnects, so senders keep succeeding while undelivered messages pile up by the hundreds a second.",
        "x": 1320, "y": 472, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "wa-note-media", "kind": "note",
        "text": "Photos and video ride a separate path and never touch the chat core, so a media outage leaves messaging alone.",
        "x": 800, "y": 568, "width": 236, "size": "md", "font": "hand"
      }
    ]
