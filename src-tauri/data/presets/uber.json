      { "id": "ub-sec-match", "kind": "section", "label": "Finding a driver", "x": 532, "y": 44, "width": 760, "height": 250, "tone": 0 },
      { "id": "ub-sec-trip", "kind": "section", "label": "The trip, and getting paid", "x": 532, "y": 368, "width": 760, "height": 250, "tone": 1 },
      { "id": "ub-sec-fire", "kind": "section", "label": "Where the drivers are, updated constantly", "x": 12, "y": 692, "width": 1280, "height": 380, "tone": 2 },
      {
        "id": "ub-note-fan", "kind": "note",
        "text": "One rider request touches four services before an offer comes back. The slowest of them sets the wait, so a match happens at the speed of the weakest link here.",
        "x": 1320, "y": 40, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "ub-note-pay", "kind": "note",
        "text": "Drag the load to 4x and watch payments. Each charge takes 200ms and only four run at once, so it tops out near 20 a second. The breaker in front notices and starts failing fast, which beats every trip request piling up behind a slow card network.",
        "x": 1320, "y": 368, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "ub-note-geo", "kind": "note",
        "text": "The location index is split by map cell. Give it a hot key and the whole city crowds into one cell, so that one shard saturates while the rest sit idle.",
        "x": 1320, "y": 696, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "ub-note-lag", "kind": "note",
        "text": "400 driver pings a second go onto one stream, and three readers consume it on their own clocks. If the map updater falls behind, dispatch quietly matches on stale positions and nothing on the rider path shows an error.",
        "x": 16, "y": 336, "width": 236, "size": "md", "font": "hand"
      }
    ]
