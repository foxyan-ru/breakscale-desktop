      { "id": "sr-sec-charge", "kind": "section", "label": "Taking one payment", "x": 532, "y": 44, "width": 1280, "height": 250, "tone": 0 },
      { "id": "sr-sec-after", "kind": "section", "label": "What happens after the money moves", "x": 532, "y": 434, "width": 1280, "height": 120, "tone": 1 },
      { "id": "sr-sec-report", "kind": "section", "label": "Reading the money back out", "x": 532, "y": 628, "width": 1020, "height": 120, "tone": 2 },
      {
        "id": "sr-note-idem", "kind": "note",
        "text": "A payment is the one thing you must never do twice. Each charge carries a key, and a retry of a charge already made gets the stored answer back instead of a second charge.",
        "x": 16, "y": 320, "width": 236, "size": "md", "font": "hand"
      },
      {
        "id": "sr-note-breaker", "kind": "note",
        "text": "Right click the card networks and inject errors. The breaker beside them opens, and charges start failing immediately instead of hanging. A payment that fails cleanly can be retried; one left in the air while a slow network times out is the one nobody can account for.",
        "x": 1840, "y": 40, "width": 300, "size": "md", "font": "hand"
      },
      {
        "id": "sr-note-report", "kind": "note",
        "text": "Dashboards read copies of the ledger, behind their own limit. Someone loading a big report can never make a payment wait, because the two never share a queue.",
        "x": 16, "y": 776, "width": 236, "size": "md", "font": "hand"
      }
    ]
