      {
        "id": "fs-note-cdn", "kind": "note",
        "text": "Two thirds of the traffic never gets past the edge cache. Only the misses reach anything below, which is why everything behind it looks so lightly loaded at rest.",
        "x": 1584, "y": 40, "width": 236, "size": "md", "font": "hand"
      },
      {
        "id": "fs-note-lesson", "kind": "note",
        "text": "Take the load to 4x and watch both halves. The sharded store saturates and the client sees errors straight away. The workers saturate too, but the queue swallows the excess, so the client is still told everything is fine while a backlog builds that takes hours to drain.",
        "x": 16, "y": 336, "width": 300, "size": "md", "font": "hand"
      }
